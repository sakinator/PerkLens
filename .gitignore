# Python caches
__pycache__/
*.py[cod]
*$py.class

# Built application files
*.apk
*.aar
*.ap_
*.aab

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/
build/
app/build/
.gradle/

# Gradle cache files
.gradle/

# Local configuration file (sdk path, credentials) - NEVER COMMIT
local.properties
secrets.properties
apikey.properties
*.key
*.keystore
*.jks
*.p12

# Environment and sensitive keys
.env
.env.*
*.env

# Google Services config file (contains API keys/project IDs)
google-services.json

# Proguard folder generated by Android Studio
proguard/

# Log Files
*.log

# Android Studio / IntelliJ IDEA
.idea/
*.iml
*.ipr
*.iws

# OS-specific files
.DS_Store
Thumbs.db

# Output and cache directories
captures/
.externalNativeBuild/
.cxx/
